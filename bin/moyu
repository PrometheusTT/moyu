#!/bin/sh
# moyu —— 终端里的摸鱼游戏。
#
# sh 这一层只负责顺着 npm 的软链定位包根、判断 Node 能否运行源码，然后把进程替换成
# Node supervisor。终端所有权和崩溃还原都在 supervisor/worker 的 ACK 协议里；这里不保留
# 第二份逃生字节，也不创建临时文件。

set -u

# `npm i -g` / `npx` 的 $0 是 <prefix>/bin/moyu 软链。macOS readlink 没有 -f，手动走链。
self=$0
links=0
while [ -L "$self" ] && [ "$links" -lt 40 ]; do
  target=$(readlink "$self") || break
  case $target in
    /*) self=$target ;;
    *)  self=${self%/*}/$target ;;
  esac
  links=$((links + 1))
done

case $self in
  */*) selfdir=${self%/*} ;;
  *)   selfdir=. ;;
esac
root=$(cd "$selfdir/.." && pwd) || exit 1

node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null) || {
  printf 'moyu: 找不到可用的 Node.js（需要 Node >= 20）\n' >&2
  exit 1
}
node_minor=$(node -p 'process.versions.node.split(".")[1]' 2>/dev/null) || exit 1

# GitHub 源码压缩包也带 src/，但装进 node_modules 后 Node 不允许直接剥离其中的 TS。
# 只有真实 checkout 才从源码启动；安装包始终运行随包提供的 dist/。
if [ -e "$root/.git" ] && [ -f "$root/src/app/main.ts" ] && [ -f "$root/src/app/supervisor.ts" ] \
  && [ "${MOYU_DIST:-}" != 1 ] \
  && { [ "$node_major" -gt 22 ] || { [ "$node_major" -eq 22 ] && [ "$node_minor" -ge 6 ]; }; }; then
  supervisor="$root/src/app/supervisor.ts"
  worker="$root/src/app/main.ts"
  # shellcheck disable=SC2086
  exec node --experimental-strip-types --disable-warning=ExperimentalWarning "$supervisor" "$worker" "$@"
elif [ -f "$root/dist/app/main.js" ] && [ -f "$root/dist/app/supervisor.js" ]; then
  supervisor="$root/dist/app/supervisor.js"
  worker="$root/dist/app/main.js"
  exec node "$supervisor" "$worker" "$@"
else
  printf 'moyu: 找不到 %s\n' "$root/dist/app/supervisor.js / $root/dist/app/main.js" >&2
  printf 'moyu: dist/ 本该跟包一起发的。重装：npm i -g https://codeload.github.com/PrometheusTT/moyu/tar.gz/refs/heads/main（在仓库里的话：npm run compile）\n' >&2
  exit 1
fi
